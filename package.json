{
  "name": "create-nextjs-mcp",
  "version": "1.0.0",
  "description": "MCP server that creates production-ready Next.js SaaS applications with authentication, payments, team management, and complete development setup",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "create-nextjs-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "global-install": "npm link",
    "global-uninstall": "npm unlink -g",
    "test": "tsx src/testing/run-tests.ts run",
    "test:cleanup": "tsx src/testing/run-tests.ts cleanup",
    "test:help": "tsx src/testing/run-tests.ts help",
    "test:nextjs": "node run-nextjs-tests.js",
    "test:reliability": "node run-nextjs-tests.js all",
    "test:contract": "node run-nextjs-tests.js contract",
    "test:integration": "node run-nextjs-tests.js integration",
    "test:rollback": "node run-nextjs-tests.js rollback",
    "test:e2e": "playwright test --config playwright-e2e.config.ts",
    "test:e2e:headed": "playwright test --config playwright-e2e.config.ts --headed",
    "test:e2e:ui": "playwright test --config playwright-e2e.config.ts --ui",
    "test:auth": "playwright test tests/e2e/auth-flows.spec.ts",
    "test:database": "vitest tests/integration/database-integration.test.ts",
    "test:stripe": "vitest tests/integration/stripe-payments.test.ts",
    "test:performance": "vitest tests/performance/template-generation-benchmarks.test.ts",
    "test:payments": "playwright test tests/e2e/payment-flows.spec.ts",
    "test:teams": "playwright test tests/e2e/team-management.spec.ts",
    "test:i18n": "playwright test tests/e2e/internationalization.spec.ts",
    "test:middleware": "vitest tests/integration/middleware-functionality.test.ts",
    "test:forms": "playwright test tests/e2e/form-validation.spec.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:coverage:unit": "vitest run tests/unit --coverage",
    "test:coverage:integration": "vitest run tests/integration --coverage",
    "test:coverage:contract": "vitest run tests/contract --coverage",
    "test:coverage:html": "vitest run --coverage --reporter=html",
    "test:coverage:json": "vitest run --coverage --reporter=json",
    "coverage:generate": "tsx scripts/generate-coverage-reports.ts",
    "coverage:serve": "npx serve coverage/reports",
    "coverage:ci": "npm run test:coverage && npm run coverage:generate",
    "test:coverage:view": "open coverage/html/index.html || start coverage/html/index.html || xdg-open coverage/html/index.html",
    "test:coverage:report": "vitest run --config vitest.coverage.config.ts --coverage --reporter=html"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "fs-extra": "^11.2.0",
    "path": "^0.12.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/coverage-istanbul": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "tsx": "^4.20.5",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nextjs",
    "saas",
    "starter",
    "template",
    "authentication",
    "stripe",
    "payments",
    "drizzle",
    "typescript",
    "tailwind",
    "shadcn-ui",
    "team-management",
    "jwt",
    "postgresql"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/create-nextjs-mcp"
  },
  "homepage": "https://github.com/your-username/create-nextjs-mcp#readme",
  "bugs": {
    "url": "https://github.com/your-username/create-nextjs-mcp/issues"
  }
}
